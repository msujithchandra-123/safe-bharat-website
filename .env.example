# ---------------------------------------------------------------------------
# Safe Bharat website — environment variables
# Copy to `.env` for local development. Never commit real credentials.
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle at build
# time; everything else stays on the server.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (PostgreSQL) --------------------------------------------------
# Option A (Docker): `docker compose up -d` starts PostgreSQL on port 5444.
# Option B (no Docker): a native Windows PostgreSQL service (default port 5432), e.g.
#   DATABASE_URL=postgresql://safebharat:<password>@localhost:5432/safebharat
# Option C: a managed cloud database (Neon, Supabase, RDS) with ?sslmode=require.
DATABASE_URL=postgresql://safebharat:safebharat_local@localhost:5444/safebharat
# Used only by the integration tests (`npm run test:integration`).
TEST_DATABASE_URL=postgresql://safebharat:safebharat_local@localhost:5444/safebharat_test

# --- Email (SMTP, Gmail by default) ------------------------------------------
# The site signs in to a mailbox over SMTP and sends from it. For Gmail:
#   1. Sign in to the sending Gmail account and turn on 2-Step Verification
#      (myaccount.google.com -> Security).
#   2. Create an App Password at myaccount.google.com/apppasswords.
#   3. Put the 16-character App Password in SMTP_PASSWORD. Your normal Gmail
#      password does NOT work. Spaces in the App Password are ignored.
# Gmail allows roughly 500 recipients per day.
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS (recommended); 587 = STARTTLS.
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Defaults to "Safe Bharat <SMTP_USER>". Gmail rewrites any other From address,
# so keep it on the SMTP_USER mailbox. Alias accepted: CONTACT_FROM_EMAIL
EMAIL_FROM=
# Comma-separated business inboxes that receive new-enquiry notifications.
# Alias accepted: CONTACT_NOTIFICATION_EMAIL
ENQUIRY_NOTIFICATION_TO=safebharatsales@gmail.com
# Automatically resend failed notifications (after new enquiries and in the
# scheduled job). Enabled unless set to "false". Set to false to pause resends,
# e.g. while switching email senders; failed notifications stay queued untouched.
EMAIL_AUTO_RETRY=true
# Send an acknowledgement email to the customer after an enquiry (true/false).
SEND_CUSTOMER_ACKNOWLEDGEMENT=true

# --- Spam protection (Cloudflare Turnstile) -----------------------------------
# The values below are Cloudflare's official always-pass TEST keys for local use.
# Replace both with real keys from the Cloudflare dashboard before going live.
# In production the test secret is refused (submissions fail closed) unless
# ALLOW_TURNSTILE_TEST_KEYS=true, which exists only for the automated E2E run.
# Never set ALLOW_TURNSTILE_TEST_KEYS on a real deployment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- AI chatbot ----------------------------------------------------------------
# Choose the provider explicitly: "gemini" or "anthropic". There is no automatic
# fallback between providers. Leave the chosen provider's key empty to disable
# the assistant; the chat panel then shows direct contact options instead.
# All of these are server-only: never use a NEXT_PUBLIC_ name for an AI key.
LLM_PROVIDER=anthropic

# Google Gemini (LLM_PROVIDER=gemini). Key from Google AI Studio (aistudio.google.com/apikey).
# Use a billing-enabled (paid) key for a public site: on the free tier Google may use
# prompts for product improvement and human review, and its terms say not to send
# personal information.
GEMINI_API_KEY=
# Verified 2026-10-15 at ai.google.dev/gemini-api/docs/models (stable). Alternative: gemini-3.8-flash.
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high
GEMINI_THINKING_LEVEL=low

# Anthropic (LLM_PROVIDER=anthropic). Key from platform.claude.com/settings/keys.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high — low keeps replies fast and inexpensive for website chat.
LLM_EFFORT=low

# --- Optional file attachments (S3-compatible private bucket) ----------------
# Leave blank to hide the attachment field. Works with AWS S3 or Cloudflare R2.
ATTACHMENTS_BUCKET=
ATTACHMENTS_REGION=auto
ATTACHMENTS_ENDPOINT=
ATTACHMENTS_ACCESS_KEY_ID=
ATTACHMENTS_SECRET_ACCESS_KEY=

# --- Contact shortcuts -------------------------------------------------------
# International format without "+" (e.g. 91XXXXXXXXXX). Leave blank to hide
# WhatsApp links. Confirm the number is registered on WhatsApp before setting.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Operations ----------------------------------------------------------------
# Shared secret for the email retry job (sent as "Authorization: Bearer <secret>").
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Enquiries (and attachments) older than this many days are deleted by the
# maintenance job. Minimum 30. Must match what the privacy policy states.
ENQUIRY_RETENTION_DAYS=730
# Salt used to hash client IP addresses before they are used as rate-limit keys.
RATE_LIMIT_SALT=change-me-to-a-long-random-string
